{
  "orgName": "VoltEdge Fresh CI",
  "edition": "Developer",
  "description": "Disposable VoltEdge scratch org for clean deployment and CI validation.",
  "hasSampleData": false,
  "features": [
    "EnableSetPasswordInApi",
    "ServiceCloud",
    "ServiceUser",
    "SalesUser"
  ],
  "settings": {
    "currencySettings": {
      "enableMultiCurrency": true
    },
    "languageSettings": {
    "enableTranslationWorkbench": true
    },
    "quoteSettings": {
      "enableQuote": true,
      "enableQuotesWithoutOppEnabled": false
    },
    "omniChannelSettings": {
      "enableOmniChannel": true
    },
    "lightningExperienceSettings": {
      "enableS1DesktopEnabled": true
    }
  }
}