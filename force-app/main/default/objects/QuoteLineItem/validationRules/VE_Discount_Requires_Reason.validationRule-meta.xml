<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VE_Discount_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    Effective_Discount__c &gt; 0,
    ISPICKVAL(Discount_Reason__c, &quot;&quot;)
)</errorConditionFormula>
    <errorMessage>Select a Discount Reason when any effective discount is applied.</errorMessage>
</ValidationRule>
