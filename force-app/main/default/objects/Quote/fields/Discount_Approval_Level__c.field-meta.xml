<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Discount_Approval_Level__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    Maximum_Line_Discount__c &gt; 0.20,
    &quot;Commercial Director&quot;,
    IF(
        Maximum_Line_Discount__c &gt; 0.10,
        &quot;Sales Manager&quot;,
        &quot;No Approval&quot;
    )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Discount Approval Level</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
